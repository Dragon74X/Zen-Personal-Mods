        "operator": "OR"
      }
    ],
    "operator": "AND"
  },
  {
    "type": "dropdown",
    "property": "zzlib.stack.size",
    "label": "Size *Row height, picture and text together.*",
    "defaultValue": "1",
    "options": [
      {
        "label": "Small",
        "value": "0.8"
      },
      {
        "label": "Smaller",
        "value": "0.9"
      },
      {
        "label": "Zen's",
        "value": "1"
      },
      {
        "label": "Larger",
        "value": "1.15"
      },
      {
        "label": "Large",
        "value": "1.3"
      }
    ],
    "conditions": [
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "downloads"
            }
