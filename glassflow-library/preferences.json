        "operator": "OR"
      }
    ],
    "operator": "AND"
  },
  {
    "type": "string",
    "property": "zzlib.card.gradient",
    "label": "Space gradient strength *The space's own colour gradient on its card. 1 is Zen's; 0 hides it.*",
    "defaultValue": "1",
