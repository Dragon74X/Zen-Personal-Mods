[
  {
    "type": "separator",
    "label": "Glassflow Library",
    "size": "20px",
    "margin": "2px 0 12px 0"
  },
  {
    "type": "dropdown",
    "property": "zzlib.ui.page",
    "label": "Show settings for *Pick one part at a time, or Everything. Settings keep their values while hidden.*",
    "defaultValue": "window",
    "options": [
      {
        "label": "Library window",
        "value": "window"
      },
      {
        "label": "Recent downloads",
        "value": "downloads"
      },
      {
        "label": "Space cards",
        "value": "cards"
      },
      {
        "label": "Everything",
        "value": "all"
      }
    ]
  },
  {
    "type": "separator",
    "label": "Library window",
    "size": "17px",
    "margin": "22px 0 10px 0",
    "id": "zzlib.ui.section.window",
    "conditions": [
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "window"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "all"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": ""
            }
          }
        ],
        "operator": "OR"
      }
    ]
  },
  {
    "type": "checkbox",
    "property": "zzlib.float.enabled",
    "label": "Float the Library *Opens it as a panel floating over the page. Zen's own Library always slides in on the tab bar's side and pushes the page and the sidebar aside; off keeps that.*",
    "defaultValue": false,
    "conditions": [
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "window"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "all"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": ""
            }
          }
        ],
        "operator": "OR"
      }
    ],
    "operator": "AND"
  },
  {
    "type": "dropdown",
    "value": "number",
    "property": "zzlib.float.side",
    "label": "Where it floats *Inside the browser window.*",
    "defaultValue": 0,
    "options": [
      {
        "label": "The tab bar's side",
        "value": 0
      },
      {
        "label": "Left",
        "value": 1
      },
      {
        "label": "Right",
        "value": 2
      },
      {
        "label": "Centre",
        "value": 3
      }
    ],
    "conditions": [
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "window"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "all"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": ""
            }
          }
        ],
        "operator": "OR"
      },
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.float.enabled",
              "value": true
            }
          }
        ],
        "operator": "OR"
      }
    ],
    "operator": "AND"
  },
  {
    "type": "string",
    "property": "zzlib.float.gap",
    "label": "Space from the window's edges",
    "defaultValue": "10px",
    "placeholder": "10px",
    "conditions": [
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "window"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "all"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": ""
            }
          }
        ],
        "operator": "OR"
      },
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.float.enabled",
              "value": true
            }
          }
        ],
        "operator": "OR"
      }
    ],
    "operator": "AND"
  },
  {
    "type": "string",
    "property": "zzlib.float.radius",
    "label": "Corner radius",
    "defaultValue": "14px",
    "placeholder": "14px",
    "conditions": [
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "window"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "all"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": ""
            }
          }
        ],
        "operator": "OR"
      },
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.float.enabled",
              "value": true
            }
          }
        ],
        "operator": "OR"
      }
    ],
    "operator": "AND"
  },
  {
    "type": "checkbox",
    "property": "zzlib.float.click-away",
    "label": "Clicking outside closes it *Anywhere else in the window, the page included. Escape and the back button close it either way.*",
    "defaultValue": true,
    "conditions": [
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "window"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "all"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": ""
            }
          }
        ],
        "operator": "OR"
      },
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.float.enabled",
              "value": true
            }
          }
        ],
        "operator": "OR"
      }
    ],
    "operator": "AND"
  },
  {
    "type": "separator",
    "label": "Recent downloads",
    "size": "17px",
    "margin": "22px 0 10px 0",
    "id": "zzlib.ui.section.downloads",
    "conditions": [
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "downloads"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "all"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": ""
            }
          }
        ],
        "operator": "OR"
      }
    ]
  },
  {
    "type": "dropdown",
    "value": "number",
    "property": "zzlib.stack.open",
    "label": "Show recent downloads *The list that rises above the Library button. On click: the first click shows it, a click while it is showing opens the Library. With no downloads, a click opens the Library.*",
    "defaultValue": 0,
    "options": [
      {
        "label": "When pointing at the Library button (Zen's)",
        "value": 0
      },
      {
        "label": "On click, then the next click opens the Library",
        "value": 1
      },
      {
        "label": "Never",
        "value": 2
      }
    ],
    "conditions": [
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "downloads"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "all"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": ""
            }
          }
        ],
        "operator": "OR"
      }
    ],
    "operator": "AND"
  },
  {
    "type": "dropdown",
    "value": "number",
    "property": "zzlib.stack.count",
    "label": "How many *Zen shows 4.*",
    "defaultValue": 4,
    "options": [
      {
        "label": "1",
        "value": 1
      },
      {
        "label": "2",
        "value": 2
      },
      {
        "label": "3",
        "value": 3
      },
      {
        "label": "4",
        "value": 4
      },
      {
        "label": "5",
        "value": 5
      },
      {
        "label": "6",
        "value": 6
      },
      {
        "label": "7",
        "value": 7
      },
      {
        "label": "8",
        "value": 8
      }
    ],
    "conditions": [
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "downloads"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "all"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": ""
            }
          }
        ],
        "operator": "OR"
      },
      {
        "conditions": [
          {
            "not": {
              "property": "zzlib.stack.open",
              "value": 2
            }
          }
        ],
        "operator": "OR"
      }
    ],
    "operator": "AND"
  },
  {
    "type": "dropdown",
    "value": "number",
    "property": "zzlib.stack.order",
    "label": "Order",
    "defaultValue": 0,
    "options": [
      {
        "label": "Newest at the bottom, by the button (Zen's)",
        "value": 0
      },
      {
        "label": "Newest at the top",
        "value": 1
      }
    ],
    "conditions": [
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "downloads"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "all"
            }
          },
          {
            "if": {
