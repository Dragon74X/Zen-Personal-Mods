      {
        "conditions": [
          {
            "not": {
              "property": "zzlib.stack.open",
              "value": 2
            }
          }
        ],
        "operator": "OR"
      }
    ],
    "operator": "AND"
  },
  {
    "type": "checkbox",
    "property": "zzlib.stack.box",
    "label": "One box behind them *The downloads sit together on one panel instead of each being its own pill. With Glassflow installed the panel takes its overlay glass (Glassflow > Overlays, dialogs and status > Library download stack).*",
    "defaultValue": false,
    "conditions": [
      {
        "conditions": [
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "downloads"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
              "value": "all"
            }
          },
          {
            "if": {
              "property": "zzlib.ui.page",
