[
  {
    "type": "separator",
    "label": "Glassflow",
    "size": "20px",
    "margin": "2px 0 12px 0"
  },
  {
    "type": "separator",
    "label": "Colour",
    "size": "17px",
    "margin": "24px 0 10px 0"
  },
  {
    "type": "dropdown",
    "value": "number",
    "property": "zzglass.color.source",
    "label": "Colour source *Container colour is read from the tab itself, so tabs in different containers differ. Tabs with no container use the fallback below.*",
    "defaultValue": 0,
    "options": [
      { "label": "Container colour", "value": 0 },
      { "label": "Workspace colour", "value": 1 },
      { "label": "Custom colour", "value": 2 },
      { "label": "Folder / group colour", "value": 3 }
    ]
  },
  {
    "type": "dropdown",
    "value": "number",
    "property": "zzglass.color.fallback",
    "label": "Fallback colour *Used when a tab has no container, no folder, or the workspace has no colour set.*",
    "defaultValue": 0,
    "options": [
      { "label": "Workspace colour", "value": 0 },
      { "label": "Custom colour", "value": 1 },
      { "label": "Neutral grey", "value": 2 }
    ]
  },
  {
    "type": "string",
    "property": "zzglass.color.custom",
    "label": "Custom colour *Any CSS colour. Used when source or fallback is set to Custom.*",
    "defaultValue": "#7c8cf8",
    "placeholder": "#7c8cf8"
  },
  {
    "type": "string",
    "property": "zzglass.color.tone",
    "label": "Darkness *Mixes the source toward black. 0% keeps Zen's pastel hue, 45% is a deep jewel tone.*",
    "defaultValue": "25%",
    "placeholder": "25%"
  },
  {
    "type": "string",
    "property": "zzglass.color.secondary",
    "label": "Second gradient colour *Used by gradients whose end is set to 'Fade to a second colour'.*",
    "defaultValue": "#1b1b2b",
    "placeholder": "#1b1b2b"
  },
  {
    "type": "separator",
    "label": "Glass",
    "size": "17px",
    "margin": "24px 0 10px 0"
  },
  {
    "type": "checkbox",
    "property": "zzglass.glass.colorless",
    "label": "Colourless glass *On: blur only, no saturation or brightness shift. Off: adds saturation and contrast.*",
    "defaultValue": true
  },
  {
    "type": "string",
    "property": "zzglass.glass.intensity",
    "label": "Glass intensity *Scales every sheen, rim and glow at once. 0 removes the glass look. Range: 0 to 3.*",
    "defaultValue": "1",
    "placeholder": "1"
  },
  {
    "type": "string",
    "property": "zzglass.glass.sheen-strength",
    "label": "Sheen strength *The white highlight band only. Lower if glass looks washed out. Range: 0 to 3.*",
    "defaultValue": "1",
    "placeholder": "1"
  },
  {
    "type": "dropdown",
    "value": "number",
    "property": "zzglass.glass.sheen-direction",
    "label": "Sheen direction *Which way the highlight band runs.*",
    "defaultValue": 0,
    "options": [
      { "label": "Top to bottom", "value": 0 },
      { "label": "Bottom to top", "value": 1 },
      { "label": "Left to right", "value": 2 },
      { "label": "Right to left", "value": 3 },
      { "label": "Diagonal", "value": 4 }
    ]
  },
  {
    "type": "checkbox",
    "property": "zzglass.glass.no-focus-flicker",
    "label": "Stop flicker on window focus *Disables transitions only while the window is inactive. May or may not affect your setup.*",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Selected tab",
    "size": "17px",
    "margin": "24px 0 10px 0"
  },
  {
    "type": "checkbox",
    "property": "zzglass.selected.enabled",
    "label": "Style selected tabs *Independent switch.*",
    "defaultValue": true
  },
  {
    "type": "string",
    "property": "zzglass.selected.tint",
    "label": "Tint strength *How much source colour this state starts with.*",
    "defaultValue": "42%",
    "placeholder": "42%"
  },
  {
    "type": "string",
    "property": "zzglass.selected.opacity",
    "label": "Opacity *Fades the whole tab including label and favicon.*",
    "defaultValue": "1",
    "placeholder": "1"
  },
  {
    "type": "dropdown",
    "value": "number",
    "property": "zzglass.selected.direction",
    "label": "Gradient direction *Independent of every other state.*",
    "defaultValue": 0,
    "options": [
      { "label": "Left to right", "value": 0 },
      { "label": "Right to left", "value": 1 },
      { "label": "Top to bottom", "value": 2 },
      { "label": "Bottom to top", "value": 3 },
      { "label": "Diagonal (down-right)", "value": 4 },
      { "label": "Diagonal (up-left)", "value": 5 },
      { "label": "Diagonal (up-right)", "value": 6 },
      { "label": "Diagonal (down-left)", "value": 7 }
    ]
  },
  {
    "type": "dropdown",
    "value": "number",
    "property": "zzglass.selected.end-mode",
    "label": "Gradient end *What the gradient fades toward.*",
    "defaultValue": 0,
    "options": [
      { "label": "Fade to transparent", "value": 0 },
      { "label": "Fade to a weaker tint", "value": 1 },
      { "label": "Fade to the second colour", "value": 2 },
      { "label": "Flat, no gradient", "value": 3 }
    ]
  },
  {
    "type": "string",
    "property": "zzglass.selected.end-tint",
    "label": "End tint *Absolute strength at the far end.*",
    "defaultValue": "17%",
    "placeholder": "17%"
  },
  {
    "type": "string",
    "property": "zzglass.selected.spread",
    "label": "Gradient spread *Where the fade finishes. 100% is edge to edge.*",
    "defaultValue": "100%",
    "placeholder": "100%"
  },
  {
    "type": "checkbox",
    "property": "zzglass.selected.sheen",
    "label": "Glass sheen *The white highlight band.*",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "zzglass.selected.rim",
    "label": "Glass rim *A 1px inner highlight along the top edge.*",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "zzglass.selected.glow",
    "label": "Outer glow *A soft tinted halo. Replaces the rim shadow.*",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "property": "zzglass.selected.blur",
    "label": "Frosted blur *One compositor pass per tab in this state. Most expensive option.*",
    "defaultValue": true
  },
  {
    "type": "string",
    "property": "zzglass.selected.blur-radius",
    "label": "Blur strength *Only used when frosted blur is on.*",
    "defaultValue": "20px",
    "placeholder": "20px"
  },
  {
    "type": "separator",
