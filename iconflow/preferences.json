[
  {
    "type": "separator",
    "label": "Iconflow",
    "size": "20px",
    "margin": "2px 0 12px 0"
  },
  {
    "type": "dropdown",
    "property": "zzicon.ui.page",
    "label": "Show settings for *Pick one part at a time, or Everything. Settings keep their values while hidden.*",
    "defaultValue": "icons",
    "options": [
      {
        "label": "Icon set",
        "value": "icons"
      },
      {
        "label": "Each button",
        "value": "buttons"
      },
      {
        "label": "Hover motion",
        "value": "motion"
      },
      {
        "label": "Library button",
        "value": "library"
      },
      {
        "label": "New tab button",
        "value": "newtab"
      },
      {
        "label": "Everything",
        "value": "all"
      }
    ]
  },
  {
    "type": "separator",
    "label": "Icon set",
    "size": "17px",
    "margin": "22px 0 10px 0",
    "id": "zzicon.ui.section.icon-set",
    "conditions": [{"conditions": [{"if": {"property": "zzicon.ui.page", "value": "icons"}}, {"if": {"property": "zzicon.ui.page", "value": "all"}}, {"if": {"property": "zzicon.ui.page", "value": ""}}], "operator": "OR"}]
  },
  {
    "type": "dropdown",
    "value": "number",
    "property": "zzicon.set",
    "label": "Icon set *Zen's own keeps Zen's icons, or New Icons' if that mod is installed. Circuit is high-tech glass: chamfered shapes with every corner rounded, a translucent body with a sheen and rim, and neon-tube lines. It animates on hover, building up speed and settling, and fast-moving parts leave trails. Each button can differ from the set under Each button.*",
    "defaultValue": 0,
    "options": [
      {
        "label": "Zen's own",
        "value": 0
      },
      {
        "label": "Circuit: glass and neon",
        "value": 2
      }
    ],
    "conditions": [{"conditions": [{"if": {"property": "zzicon.ui.page", "value": "icons"}}, {"if": {"property": "zzicon.ui.page", "value": "all"}}, {"if": {"property": "zzicon.ui.page", "value": ""}}], "operator": "OR"}],
    "operator": "AND"
  },
  {
    "type": "checkbox",
    "property": "zzicon.animate",
    "label": "Animate icons on hover *Each Circuit icon plays its own short animation while hovered and plays it back when the pointer leaves. Off keeps them still.*",
    "defaultValue": true,
    "conditions": [{"conditions": [{"if": {"property": "zzicon.ui.page", "value": "icons"}}, {"if": {"property": "zzicon.ui.page", "value": "all"}}, {"if": {"property": "zzicon.ui.page", "value": ""}}], "operator": "OR"}],
    "operator": "AND"
  },
  {
    "type": "dropdown",
    "property": "zzicon.speed",
    "label": "Animation speed",
    "defaultValue": "0.45s",
    "options": [
      {
        "label": "Quick",
        "value": "0.3s"
      },
      {
        "label": "Smooth",
        "value": "0.45s"
      },
      {
        "label": "Slow",
        "value": "0.7s"
      }
    ],
    "conditions": [{"conditions": [{"if": {"property": "zzicon.ui.page", "value": "icons"}}, {"if": {"property": "zzicon.ui.page", "value": "all"}}, {"if": {"property": "zzicon.ui.page", "value": ""}}], "operator": "OR"}, {"conditions": [{"if": {"property": "zzicon.animate", "value": true}}], "operator": "OR"}],
    "operator": "AND"
  },
  {
    "type": "checkbox",
    "property": "zzicon.circuit.glow",
    "label": "Circuit icons glow on hover *A soft light around the icon in its own colour, like a lit neon tube.*",
    "defaultValue": true,
    "conditions": [{"conditions": [{"if": {"property": "zzicon.ui.page", "value": "icons"}}, {"if": {"property": "zzicon.ui.page", "value": "all"}}, {"if": {"property": "zzicon.ui.page", "value": ""}}], "operator": "OR"}],
    "operator": "AND"
  },
  {
    "type": "separator",
    "label": "Glass behind buttons",
    "size": "17px",
    "margin": "22px 0 10px 0",
    "id": "zzicon.ui.section.glass-plates",
    "conditions": [{"conditions": [{"if": {"property": "zzicon.ui.page", "value": "icons"}}, {"if": {"property": "zzicon.ui.page", "value": "all"}}, {"if": {"property": "zzicon.ui.page", "value": ""}}], "operator": "OR"}]
  },
  {
    "type": "dropdown",
    "value": "number",
    "property": "zzicon.plate",
    "label": "Glass plates *A glass plate behind sidebar and toolbar buttons, made like Glassflow's window buttons: a light fill, a sheen across the top, a rim, and a blur of what is behind. With Glassflow installed it uses Glassflow's own sheen and rim, so they follow its Glass settings.*",
    "defaultValue": 0,
    "options": [
      {
        "label": "Off",
        "value": 0
      },
      {
        "label": "While hovered",
        "value": 1
      },
      {
        "label": "Always",
        "value": 2
      }
    ],
    "conditions": [{"conditions": [{"if": {"property": "zzicon.ui.page", "value": "icons"}}, {"if": {"property": "zzicon.ui.page", "value": "all"}}, {"if": {"property": "zzicon.ui.page", "value": ""}}], "operator": "OR"}],
